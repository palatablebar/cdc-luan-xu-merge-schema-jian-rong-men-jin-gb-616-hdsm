# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=cdcmerge

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18205
BACKEND_PORT=19205
DB_PORT=17705

# ---- 数据库 ----
DB_NAME=cdcmerge
DB_USER=cdcmerge
DB_PASSWORD=cdcmerge_pw_2026
DB_ROOT_PASSWORD=cdcmerge_root_2026

# ---- 安全 ----
JWT_SECRET=cdcmerge-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
# 业务时区（展示时间按 UTC+8 解释）
APP_TIMEZONE_OFFSET_MINUTES=480

# ---- 断点续跑 ----
# 每个分块处理的事件数（处理完刷新心跳与进度并提交一次）
MERGE_CHUNK_SIZE=200
# 分块间停顿秒数（演示让“处理中/剩余数量”可见，生产可置 0）
MERGE_CHUNK_DELAY_SECONDS=0.05
# running 心跳超过该秒数未刷新即判 interrupted
RUN_STALE_SECONDS=60
# 故障注入（仅测试/演示，默认 0 关闭）：第 N 个分块后中断 / 累计确认事件数达到后中断
MERGE_FAIL_AFTER_CHUNKS=0
MERGE_FAIL_AFTER_EVENTS=0
